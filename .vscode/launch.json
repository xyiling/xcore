{
    "configurations": [
    {
        "name": "调试内核程序",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/bin/boot.bin",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "pipeTransport": {
            "debuggerPath": "C:\\cygwin64\\bin\\gdb.exe",
            "pipeProgram": "C:\\cygwin64\\bin\\bash.exe",
            "pipeArgs": ["-c"],
            "pipeCwd": ""
        },
        "preLaunchTask": "运行 QEMU",
        "setupCommands": [
            {
                "description": "为 gdb 启用整齐打印",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "将反汇编风格设置为 Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }
    ]
}