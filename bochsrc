# bochsrc debug configuration
plugin_ctrl: biosdev=true, busmouse=false, e1000=false, es1370=false, extfpuirq=true, gameport=true, iodebug=true, ne2k=false, parallel=true, pcidev=false, pcipnic=false, sb16=false, serial=true, speaker=true, unmapped=true, usb_ehci=false, usb_ohci=false, usb_uhci=false, usb_xhci=false, voodoo=false
config_interface: textconfig
memory: guest=32, host=32, block_size=128

# 基本配置
romimage: file=/usr/share/bochs/BIOS-bochs-latest, address=0x00000000, options=none, flash_data=none
vgaromimage: file="/usr/share/bochs/VGABIOS-lgpl-latest"
megs: 16

# 磁盘配置
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, path="bin/kernel.img", mode=flat, cylinders=40, heads=16, spt=63

# 启动顺序
boot: disk

# 调试配置
# gdbstub: enabled=1, port=1234, text_base=0, data_base=0, bss_base=0

# 日志配置
log: bochsout.txt
error: action=report
info: action=report
debug: action=report

# 显示配置
display_library: x, options="gui_debug"

# 其他配置
clock: sync=realtime, time0=local

# cpu
cpu: count=1, ips=10000000